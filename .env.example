# Copy to .env and fill in. .env is git-ignored: never commit keys.

# At least one key is needed for real runs. Tests need none (they use a scripted fake LLM).
GEMINI_API_KEY=
GROQ_API_KEY=

# Model tiers. "fast" runs the evidence-gathering agents, "strong" runs reasoning and
# critique (and the single-agent baseline). Format: provider:model. The first entry is
# used; the rest are fallbacks on rate limits or provider errors.
MODELS_FAST=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
MODELS_STRONG=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# Cache LLM responses on disk (makes repeated runs free). Turn off for latency numbers.
LLM_CACHE=true
